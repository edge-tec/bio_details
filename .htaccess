# ============================================
# Dynamic Personal Biography Website
# Apache Configuration
# ============================================

# Enable Rewrite Engine
RewriteEngine On

# Set base directory
RewriteBase /

# ============================================
# SECURITY HEADERS
# ============================================

<IfModule mod_headers.c>
    # Prevent MIME-sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # XSS Protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    
    # Remove server signature
    Header unset Server
    Header unset X-Powered-By
</IfModule>

# ============================================
# DISABLE DIRECTORY LISTING
# ============================================

Options -Indexes
Options -MultiViews

# ============================================
# PROTECT SENSITIVE FILES
# ============================================

# Block access to config, classes, functions, templates, logs, database directories
<FilesMatch "\.(sql|log|md|json|lock|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to hidden files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protect sensitive directories from direct access
RewriteRule ^config/ - [F,L]
RewriteRule ^classes/ - [F,L]
RewriteRule ^functions/ - [F,L]
RewriteRule ^templates/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^database/ - [F,L]
RewriteRule ^logs/ - [F,L]

# ============================================
# PERFORMANCE
# ============================================

<IfModule mod_deflate.c>
    # Compress HTML, CSS, JavaScript, Text, XML
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images - 1 month
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS & JS - 1 week
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    
    # Fonts - 1 month
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/ttf "access plus 1 month"
</IfModule>

# ============================================
# CLEAN URL ROUTING
# ============================================

# Allow direct access to existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route sitemap.xml to sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Admin panel routing
RewriteRule ^admin/?$ admin/index.php [L]
RewriteRule ^admin/([a-zA-Z0-9_-]+)/?$ admin/index.php?page=$1 [L,QSA]

# Blog single post routing
RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ index.php?page=blog-single&slug=$1 [L,QSA]

# Blog category routing
RewriteRule ^blog/category/([a-zA-Z0-9_-]+)/?$ index.php?page=blog&category=$1 [L,QSA]

# Blog tag routing
RewriteRule ^blog/tag/([a-zA-Z0-9_-]+)/?$ index.php?page=blog&tag=$1 [L,QSA]

# Portfolio single routing
RewriteRule ^portfolio/([a-zA-Z0-9_-]+)/?$ index.php?page=portfolio&slug=$1 [L,QSA]

# General page routing (must be last)
RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?page=$1 [L,QSA]

# ============================================
# ERROR DOCUMENTS
# ============================================

ErrorDocument 404 /index.php?page=404
ErrorDocument 403 /index.php?page=404
ErrorDocument 500 /index.php?page=404

# ============================================
# PHP SETTINGS (if applicable)
# ============================================

<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
    php_value session.cookie_httponly 1
    php_value session.use_strict_mode 1
</IfModule>
